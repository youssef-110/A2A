{
  // A2A relay on Cloudflare: one Worker, one SQLite-backed Durable Object, the console as static assets.
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "a2a-relay",
  "main": "src/worker.ts",
  "compatibility_date": "2025-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "../console/public",
    "binding": "ASSETS",
    "html_handling": "none",
    "run_worker_first": ["/", "/v1/*", "/healthz", "/join/*"]
  },
  "durable_objects": {
    "bindings": [{ "name": "RELAY", "class_name": "RelayDO" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["RelayDO"] }],
  "vars": {
    "A2A_ORG": "acme",
    "A2A_RELAY_NAME": "a2a-relay"
  },
  "observability": { "enabled": true }
  // Secrets (wrangler secret put): A2A_ADMIN_TOKEN, RESON8_API_KEY (voice), ANTHROPIC_API_KEY (optional LLM guard)
}
